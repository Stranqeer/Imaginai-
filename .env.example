# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
# Copy this file to .env.local and restart `npm run dev` after you change it.
# GOOGLE_API_KEY or GOOGLE_GENAI_API_KEY is used when GEMINI_API_KEY is unset.
# Leave the value empty to see the in-app missing-key message. Do not commit a real key.
GEMINI_API_KEY=
